-- StarterGui.ScreenGui.Main.LocalScript
local function C_e2()
local script = G2L["e2"];
	local main = script.Parent
	local pagesFolder = main:FindFirstChild("Pages")
	
	local page1 = main:FindFirstChild("ScriptPage1")
	local page2 = main:FindFirstChild("ScriptPage2")
	
	local function showPage(pageToShow)
		page1.Visible = false
		page2.Visible = false
	
		if pageToShow then
			pageToShow.Visible = true
		end
	end
	
	local btn1 = pagesFolder:FindFirstChild("Page1"):FindFirstChildWhichIsA("TextButton")
	local btn2 = pagesFolder:FindFirstChild("Page2"):FindFirstChildWhichIsA("TextButton")
	
	if btn1 then
		btn1.MouseButton1Click:Connect(function()
			showPage(page1)
		end)
	end
	
	if btn2 then
		btn2.MouseButton1Click:Connect(function()
			showPage(page2)
		end)
	end
	
	showPage(page1)
end;
task.spawn(C_e2);
-- StarterGui.ScreenGui.Main.Drag
local function C_e3()
local script = G2L["e3"];
	local UserInputService = game:GetService("UserInputService")
	
	local gui = script.Parent
	
	local dragging
	local dragInput
	local dragStart
	local startPos
	
	local function update(input)
		local delta = input.Position - dragStart
		gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
	
	gui.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = gui.Position
	
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	
	gui.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			update(input)
		end
	end)
end;
task.spawn(C_e3);

return G2L["1"], require;
