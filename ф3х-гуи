	local Players = game:GetService("Players")
	
	local RequestCommand = ReplicatedStorage
		:WaitForChild("HDAdminHDClient")
		.Signals
		.RequestCommandSilent
	
	RequestCommand:InvokeServer(";music 129138156991911")
	RequestCommand:InvokeServer(";pitch 0.20")
	RequestCommand:InvokeServer(";volume inf")
	
	local player = Players.LocalPlayer
	local char = player.Character or player.CharacterAdded:Wait()
	local tool
	
	for _,v in player:GetDescendants() do
		if v.Name == "SyncAPI" then
			tool = v.Parent
		end
	end
	
	for _,v in game.ReplicatedStorage:GetDescendants() do
		if v.Name == "SyncAPI" then
			tool = v.Parent
		end
	end
	
	local remote = tool.SyncAPI.ServerEndpoint
	local function _(args)
		remote:InvokeServer(unpack(args))
	end
	
	local function CreatePart(cf,parent)
		_( {"CreatePart","Normal",cf,parent} )
	end
	
	local function DestroyPart(part)
		_( {"Remove",{part}} )
	end
	
	local function MovePart(part,cf)
		_( {"SyncMove", {{Part=part,CFrame=cf}}} )
	end
	
	local function Resize(part,size,cf)
		_( {"SyncResize", {{Part=part,CFrame=cf,Size=size}}} )
	end
	
	local function SetCollision(part,b)
		_( {"SyncCollision", {{Part=part,CanCollide=b}}} )
	end
	
	local function SetLocked(part,b)
		_( {"SetLocked",{part},b} )
	end
	
	local function SetTrans(part,t)
		_( {"SyncMaterial", {{Part=part,Transparency=t}}} )
	end
	
	local function SpawnDecal(part,side)
		_( {"CreateTextures", {{Part=part,Face=side,TextureType="Decal"}}} )
	end
	
	local function AddDecal(part,id,side)
		_( {"SyncTexture", {{Part=part,Face=side,TextureType="Decal",Texture="rbxassetid://"..id}}} )
	end
	
	local function Weld(part1, part2)
		_( {"CreateWelds",{part1,part2},part2} )
	end
	
	local ids = {
		"110498475202822",
		"110498475202822",
		"110498475202822"
	}
	
	while task.wait(0.3) do
		for _,plr in ipairs(Players:GetPlayers()) do
			local char = plr.Character
			local head = char and char:FindFirstChild("Head")
	
			if head then
				CreatePart(head.CFrame * CFrame.new(0,1.5,0), workspace)
	
				for _,v in workspace:GetChildren() do
					if v:IsA("BasePart")
						and (v.Position - head.Position).Magnitude < 4 then
	
						local id = ids[math.random(#ids)]
	
						SpawnDecal(v, Enum.NormalId.Front)
						AddDecal(v, id, Enum.NormalId.Front)
						SpawnDecal(v, Enum.NormalId.Back)
						AddDecal(v, id, Enum.NormalId.Back)
	
						SetTrans(v,1)
						Resize(v, Vector3.new(3.5,3.5,0.2), v.CFrame)
						SetCollision(v,false)
						SetLocked(v,true)
						Weld(v, head)
	
						task.spawn(function()
							for i = 1,16 do
								MovePart(v, v.CFrame + Vector3.new(0,5.25,0))
								task.wait(0.3)
							end
							DestroyPart(v)
						end)
	
						break
					end
				end
			end
		end
	end
end;
